{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{ico,png,jpg,jpeg,webp,svg,txt,xml,css,js}"]
  },
  "routes": [
    { "route": "/nosotros", "redirect": "/conocenos", "statusCode": 301 },
    { "route": "/quien-somos", "redirect": "/conocenos", "statusCode": 301 }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    "webp": "image/webp"
  }
}
