# Configuración para hosting Apache (GoDaddy cPanel)
# Hace que /servicios, /contactanos, etc. funcionen al recargar o al abrir el enlace directo.

Options -MultiViews
RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirecciones de rutas antiguas
RewriteRule ^nosotros/?$ /conocenos [L,R=301]
RewriteRule ^quien-somos/?$ /conocenos [L,R=301]

# Si el archivo o carpeta existe, se sirve tal cual; si no, se carga la aplicación
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# Caché larga para archivos con huella (assets/), corta para index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
